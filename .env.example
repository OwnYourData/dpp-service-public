# Copy this file to `.env` next to docker-compose.yml and fill in the three
# values below. Everything else has a working default.
#
# Generate the two secrets once, on any machine with openssl:
#
#     openssl rand -hex 64      for SECRET_KEY_BASE
#     openssl rand -hex 32      for KEY_VAULT_KEK
#
# Keep them. SECRET_KEY_BASE signs sessions. KEY_VAULT_KEK encrypts the DID keys
# of every passport this service mints itself — lose it and those passports can
# never be changed or ended again, by anybody.

SECRET_KEY_BASE=
KEY_VAULT_KEK=
DPP_DB_PASSWORD=

# The address this service is reachable at from outside. It is written into the
# DID document of every passport the service mints, and it is what the service
# compares a client-supplied DID's endpoint against — so it has to be the real
# public address before the first passport is created, not afterwards.
# DPP_SERVICE_ENDPOINT_BASE=https://dpp.example.org

# `permissive` accepts an unsigned bearer token and lets any caller change any
# passport. It is meant for a first look. For anything real, set `did`: tokens
# are then verified against the caller's DID document, and only the DID that
# created a passport may change it.
# DPP_AUTH_MODE=did

# The port on this machine. Change it if 3000 is taken.
# DPP_PORT=3000

# The application redirects http to https unless this says otherwise. The
# compose file switches it off, because on your own machine there is no TLS in
# front of the service and the redirect would point nowhere. Put a proxy or a
# load balancer with a certificate in front of it, and set this to true.
# DPP_FORCE_SSL=true

# DPP_DB_NAME=dpp_service_production
# DPP_DB_USER=dpp
