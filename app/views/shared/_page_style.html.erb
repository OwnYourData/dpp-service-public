<style>
  :root {
    color-scheme: light;
    --bg: #f7f7f5;
    --surface: #ffffff;
    --text: #1d2327;
    --muted: #5b6770;
    --line: #e2e5e8;
    --accent: #0b6e4f;
  }
  /* dark: follows the system unless the reader picked a theme (data-theme on <html>, theme.js) */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #121517;
      --surface: #1b1f22;
      --text: #e8ebed;
      --muted: #9aa5ad;
      --line: #2c3236;
      --accent: #4cc293;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #121517;
    --surface: #1b1f22;
    --text: #e8ebed;
    --muted: #9aa5ad;
    --line: #2c3236;
    --accent: #4cc293;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  a { color: var(--accent); }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 20px; }
  header { padding: 20px 0; border-bottom: 1px solid var(--line); }
  header .wrap { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .theme-toggle {
    background: none; border: 1px solid var(--line); border-radius: 8px; color: var(--muted);
    width: 34px; height: 34px; padding: 0; margin-left: 18px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; vertical-align: middle;
  }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover { color: var(--text); border-color: var(--muted); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-toggle svg { width: 18px; height: 18px; }
  .theme-toggle .icon-sun { display: none; }
  .theme-toggle[data-mode="dark"] .icon-sun { display: block; }
  .theme-toggle[data-mode="dark"] .icon-moon { display: none; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 600; color: inherit; text-decoration: none; }
  .brand .mark { width: 15px; height: auto; display: block; }
  .brand span { color: var(--muted); font-weight: 400; margin-left: -5px; }
  h1 { font-size: clamp(26px, 4vw, 34px); line-height: 1.2; margin: 40px 0 8px; }
  .updated { color: var(--muted); margin: 0 0 28px; font-size: 15px; }
  h2 { font-size: 20px; margin: 36px 0 10px; }
  h3 { font-size: 17px; margin: 22px 0 6px; }
  p, li { margin: 0 0 10px; }
  ul { padding-left: 22px; margin: 0 0 10px; }
  nav.toc { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 20px; }
  nav.toc ol { margin: 0; padding-left: 20px; }
  nav.toc li { margin: 2px 0; }
  address { font-style: normal; }
  footer { margin-top: 56px; padding: 24px 0 40px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  footer .wrap { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  footer a { color: var(--muted); }
  footer .legal a { margin-right: 16px; }
  .btn {
    display: inline-block; padding: 10px 18px; border-radius: 8px; text-decoration: none; cursor: pointer;
    font: 600 15px/1.2 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    border: 1px solid var(--accent); background: var(--accent); color: var(--surface);
  }
  .btn:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
</style>
