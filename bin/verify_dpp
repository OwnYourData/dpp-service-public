#!/usr/bin/env ruby
# frozen_string_literal: true

# verify_dpp -- check a Digital Product Passport the way a consumer can.
#
#   bundle exec ruby bin/verify_dpp https://dpp.oydapp.eu/01/09520123456788/21/000001
#
# It executes the six steps of docs/Integrity.md section 4, checks the
# signature of the economic operator (section 10), and reads the versions the
# DID log records with their signatures. It needs nothing but the
# public web: no token, no access to this service, no knowledge of who the
# custodian is. That is the point -- a verification that needed the service to
# cooperate would prove nothing about the service.
#
# What it reports is separated on purpose into what is *checked* and what is
# *not established*. EN 18246:2026 expects an external, accredited trust anchor; a
# self-managed DID log is not one, and this tool says so rather than printing a
# green tick over the question.
#
# The exit code is that of the commitment (0 attested and unchanged, 1 mismatch,
# 2 not committed, 3 incomplete). A signature of the economic operator that is
# delivered but does not hold makes it a mismatch; one that is not delivered
# changes nothing, and the verdict says whether the passport is signed.

require "cgi"
require "json"
require "httpx"
require "time"
require "uri"

# oydid reads data with CSV, which aborts when the default external encoding is
# not UTF-8 -- and aborts as "Invalid byte sequence in US-ASCII" from inside a
# method this script does not call, which points at nothing recognisable. Set it
# here so the tool does not depend on the locale of whoever runs it.
Encoding.default_external = Encoding::UTF_8

begin
  require "oydid"
rescue LoadError
  abort("verify_dpp needs the oydid gem: run it as `bundle exec ruby bin/verify_dpp <url>`")
end
require_relative "../app/lib/compact_jws"

DIGEST_OPTIONS = { digest: "sha2-256", encode: "base58btc" }.freeze
SERVICE_TYPE   = "DigitalProductPassport"
PAYLOAD_HASH   = "payloadHash"

EXIT_OK            = 0
EXIT_MISMATCH      = 1
EXIT_NO_COMMITMENT = 2
EXIT_INCOMPLETE    = 3

def say(text)  = puts(text)
def step(text) = puts("\n#{text}")
def ok(text)   = puts("  [ ok ] #{text}")
def no(text)   = puts("  [FAIL] #{text}")
def open_(text) = puts("  [open] #{text}")

# Over HTTP/2, which EN 18216:2026 clause 4 requires for DPP data exchange;
# httpx negotiates it via ALPN (Net::HTTP speaks HTTP/1.1 only).
def fetch(url, accept: "application/json")
  response = HTTPX.with(timeout: { connect_timeout: 5, read_timeout: 15 })
                  .get(url, headers: { "accept" => accept })
  raise response.error if response.is_a?(HTTPX::ErrorResponse)

  [response.status, response.to_s]
rescue StandardError => e
  abort("cannot reach #{url}: #{e.class}: #{e.message}")
end

# The serviceEndpoint is an EN 18222:2026 read path, which answers in the
# compressed representation unless asked otherwise (8.1). The commitment binds
# the full one (docs/Integrity.md section 4), so that is what is asked for.
def full_form(url)
  uri = URI.parse(url)
  query = URI.decode_www_form(uri.query.to_s).reject { |key, _| key == "representation" }
  uri.query = URI.encode_www_form(query + [%w[representation full]])
  uri.to_s
end

carrier = ARGV.first
abort("usage: bundle exec ruby bin/verify_dpp <carrier URL>") if carrier.to_s.empty?

say("Verifying #{carrier}")

# --- 1 + 2  the carrier link is the identifier, and it resolves -------------
step("1/2  fetch the passport from the carrier link")
code, body = fetch(carrier)
abort("  [FAIL] the carrier link answered #{code}") if code != 200
ok("#{code}, #{body.bytesize} bytes")

# The bytes are the subject of the hash. Not the parsed document -- parsing and
# re-serialising would produce a different byte string and a different hash.
bytes = body.dup.force_encoding(Encoding::BINARY)

document = begin
  JSON.parse(body)
rescue JSON::ParserError => e
  abort("  [FAIL] not JSON: #{e.message}")
end

# The resolver answers with the head of the log, and does so as a bare hash
# without the method prefix. Compare like with like, or an unchanged passport
# gets reported as having a newer version.
def bare(identifier) = identifier.to_s.sub(/\Adid:oyd:/, "").split("@").first.to_s

# Steps 3 to 6: the commitment in the DID document of the passport identifier.
# Returns [verdict, serviceEndpoint or nil, resolved DID or nil].
def check_commitment(carrier, bytes, document)
  # --- 3  the passport names its own identifier -------------------------------
  endpoint = nil
  step("3    read the passport identifier out of the document")
  did = document["digitalProductPassportId"].to_s
  abort("  [FAIL] the document carries no digitalProductPassportId") if did.empty?
  ok(did)
  unless did.start_with?("did:oyd:")
    open_("not a did:oyd -- there is no log to check, so integrity cannot be established this way")
    return [EXIT_NO_COMMITMENT, nil, nil]
  end

  # --- 4  resolve it ----------------------------------------------------------
  step("4    resolve the identifier")
  info, msg = Oydid.read(did, {})
  abort("  [FAIL] does not resolve: #{msg}") if info.nil?
  ok("resolved, #{Array(info['log']).length} log entries")

  head = bare(info["did"])
  if !head.empty? && head != bare(did)
    ok("current version is did:oyd:#{head} -- the carrier keeps naming #{did}")
  end

  content = info.dig("doc", "doc") || info["doc"] || {}
  entry = Array(content["service"]).find { |e| e.is_a?(Hash) && e["type"].to_s == SERVICE_TYPE }
  if entry.nil?
    no("the DID document carries no #{SERVICE_TYPE} service entry")
    return [EXIT_INCOMPLETE, endpoint, info]
  end
  ok("serviceEndpoint: #{entry['serviceEndpoint']}")

  # --- 4b  the carrier link and the endpoint the DID document names -----------
  # These are legitimately different URLs, and usually different hosts as well:
  # the carrier bears a name the economic operator owns, pointed at the custodian
  # by CNAME, which is exactly what EN 18219:2026 4.6.2 (3) asks for. A different
  # host is therefore not a finding. Different *bytes* are: the commitment can
  # only ever be about the address the DID document names, so if the carrier
  # serves something else, a consumer scanning it does not get the attested
  # document -- and that is worth saying before the hashes are compared.
  endpoint = entry["serviceEndpoint"].to_s
  authoritative = bytes

  if !endpoint.empty? && endpoint != carrier
    step("4b   compare the carrier link with the endpoint the DID document names")
    e_code, e_body = fetch(full_form(endpoint))
    if e_code != 200
      no("the endpoint named in the DID document answered #{e_code}")
      authoritative = nil
    else
      authoritative = e_body.dup.force_encoding(Encoding::BINARY)
      if authoritative == bytes
        ok("both addresses deliver the same #{bytes.bytesize} bytes")
      else
        no("carrier #{bytes.bytesize} bytes, named endpoint #{authoritative.bytesize} bytes -- they differ")
        no("a consumer scanning the carrier does NOT get the attested document")
      end
    end
  end

  # --- 5  does the document commit to these bytes? ----------------------------
  step("5    compare the delivered bytes with the commitment in the DID document")
  if authoritative.nil?
    no("nothing to compare: the custodian named by the DID document did not answer")
    return [EXIT_INCOMPLETE, endpoint, info]
  end
  computed, hash_msg = Oydid.multi_hash(authoritative, DIGEST_OPTIONS)
  abort("  [FAIL] cannot hash the payload: #{hash_msg}") if computed.to_s.empty?
  say("  delivered: #{computed}")

  committed = entry[PAYLOAD_HASH].to_s
  if committed.empty?
    say("  committed: -")
    open_("the DID document carries no #{PAYLOAD_HASH}: the place this passport is served")
    open_("from is bound to the identifier, its content is not")
    verdict = EXIT_NO_COMMITMENT
  elsif committed == computed
    say("  committed: #{committed}")
    ok("the content delivered is the content the holder attested")
    verdict = EXIT_OK
  else
    say("  committed: #{committed}")
    no("the delivered content is NOT the attested content")
    verdict = EXIT_MISMATCH
  end

  # --- 6  the log entry of the current document -------------------------------
  step("6    check the signature of the log entry that carries this document")
  log      = Array(info["log"])
  doc_id   = info["doc_log_id"]
  log_entry = doc_id.nil? ? nil : log[doc_id.to_i]
  public_doc_key = info.dig("doc", "key").to_s.split(":").first.to_s

  if log_entry.nil? || public_doc_key.empty?
    open_("the resolver returned no log entry for this document, so the signature cannot be checked")
    verdict = EXIT_INCOMPLETE if verdict == EXIT_OK
  else
    signed = Oydid.verify(log_entry["doc"].to_s, log_entry["sig"].to_s, public_doc_key).first
    if signed
      ok("entry op=#{log_entry['op']} is signed with the document key of this version")
    else
      no("the signature of entry op=#{log_entry['op']} does not verify")
      verdict = EXIT_MISMATCH
    end
  end

  [verdict, endpoint, info]
end

# The Ed25519 key of a verification method, as its DID publishes it: the
# document key of a did:oyd, or the key a did:key is made of. nil for anything
# else, which this tool cannot resolve.
def verify_key_for(kid)
  did, fragment = kid.to_s.split("#", 2)
  if did.to_s.start_with?("did:oyd:")
    return nil unless fragment == "key-doc"

    info, = Oydid.read(did, {})
    return nil if info.nil? || info["error"].to_i != 0

    raw = Oydid.multi_decode(info.dig("doc", "key").to_s.split(":").first.to_s).first
  elsif did.to_s.start_with?("did:key:z")
    raw = Oydid.multi_decode(did.delete_prefix("did:key:")).first
    return nil unless raw&.start_with?("\xed\x01".b)
  end
  raw && raw.bytesize >= 32 ? Ed25519::VerifyKey.new(raw[-32..]) : nil
rescue StandardError
  nil
end

# Step 7: the signature of the economic operator (docs/Integrity.md section 10),
# a JWS over exactly the JSON delivered at the same address, asked for with
# Accept: application/jose -- at the carrier link first, as a phone would ask,
# then at the serviceEndpoint in the full representation. Returns
# [:valid | :invalid | :none, signer or nil].
def check_signature(carrier, endpoint, operator)
  step("7    check the signature of the economic operator")
  candidates = [carrier]
  candidates << full_form(endpoint) unless endpoint.to_s.empty?

  candidates.uniq.each do |url|
    code, text = fetch(url, accept: "application/jose")
    next unless code == 200 && text.lstrip.start_with?("eyJ")

    jws = begin
      CompactJws.parse(text)
    rescue CompactJws::Malformed => e
      no("#{url} delivers something that is not a JWS: #{e.message}")
      return [:invalid, nil]
    end
    say("  delivered at #{url}")

    key = verify_key_for(jws.kid)
    if key.nil?
      no("the key #{jws.kid} cannot be resolved, so the signature cannot be checked")
      return [:invalid, jws.signer]
    end
    unless CompactJws.valid?(jws, key)
      no("the signature by #{jws.kid} does not verify")
      return [:invalid, jws.signer]
    end

    j_code, j_body = fetch(url)
    delivered = begin
      j_code == 200 ? JSON.parse(j_body) : nil
    rescue JSON::ParserError
      nil
    end
    unless delivered && jws.payload == delivered
      no("the signed content is not the passport delivered at the same address")
      return [:invalid, jws.signer]
    end

    ok("signed by #{jws.signer}, and the signed content is the passport delivered there")
    if jws.signer == operator
      ok("the signer is the economic operator the passport names")
    else
      open_("the signer is not the economic operator the passport names (#{operator.empty? ? '-' : operator}):")
      open_("an authorised representative, which cannot be recognised from here")
    end
    return [:valid, jws.signer]
  end

  open_("no signature of the economic operator is delivered for this passport")
  [:none, nil]
end

# Step 8: the changes the DID log records (docs/Integrity.md section 10). Each
# create and update entry of the log marks a version; it is read with
# ReadDPPVersionByIdAndDate at the time of the entry, at the API the endpoint
# belongs to, and its signature of the economic operator, where one is
# delivered, is checked against exactly that version. The log keeps whole
# seconds, and the change it records may lie later within that second than
# the truncated time, so the version is asked for at the end of it.
def check_changes(did, endpoint, info, operator)
  step("8    check the changes the DID log records")
  counts = { versions: 0, signed: 0, invalid: 0 }
  base = endpoint.to_s[%r{\A(.*)/dppsByProductId/}, 1]
  entries = Array(info && info["log"]).select { |e| e.is_a?(Hash) && [2, 3].include?(e["op"].to_i) && e["ts"] }
  if base.nil? || entries.empty?
    open_("no versions to read: the endpoint names no EN 18222 read path, or the log records no change")
    return counts
  end

  seen = {}
  entries.each do |entry|
    date = Time.at(entry["ts"].to_i + 1).utc.iso8601
    url = "#{base}/dppsByIdAndDate/#{CGI.escape(did)}?date=#{CGI.escape(date)}&representation=full"
    code, body = fetch(url)
    next unless code == 200

    version = JSON.parse(body) rescue next
    label = version["lastUpdated"] || date
    next if seen[label]

    seen[label] = true
    counts[:versions] += 1
    j_code, text = fetch(url, accept: "application/jose")
    unless j_code == 200 && text.lstrip.start_with?("eyJ")
      open_("version of #{label}: no signature of the economic operator")
      next
    end

    jws = CompactJws.parse(text) rescue nil
    key = jws && verify_key_for(jws.kid)
    if jws && key && CompactJws.valid?(jws, key) && jws.payload == version
      counts[:signed] += 1
      ok("version of #{label}: signed by #{jws.signer}#{jws.signer == operator ? '' : ' (not the economicOperatorId)'}")
    else
      counts[:invalid] += 1
      no("version of #{label}: the signature delivered does not hold for this version")
    end
  end

  if counts[:versions].zero?
    open_("no version could be read at #{base} for the times the DID log records")
  else
    say("  #{counts[:versions]} version(s), #{counts[:signed]} signed by the economic operator")
  end
  counts
end

verdict, endpoint, info = check_commitment(carrier, bytes, document)
operator = document["economicOperatorId"].to_s
signature, signer = check_signature(carrier, endpoint, operator)
verdict = EXIT_MISMATCH if signature == :invalid
changes = check_changes(document["digitalProductPassportId"].to_s, endpoint, info, operator)
verdict = EXIT_MISMATCH if changes[:invalid].positive?

# --- what this does not establish -------------------------------------------
step("what this does NOT establish")
open_("who asked for each change: the write log that binds every change to the")
open_("token of its author is kept by the service and checked with bin/verify_writes")
open_("from the export its operator hands the owner (docs/Integrity.md section 11)")
if signature == :valid && signer == operator
  open_("that #{signer} is the company it stands for -- EN 18219:2026 wants a")
  open_("Verifiable Credential at the operator DID for that, and none is checked here")
else
  open_("that the key which signed belongs to the economic operator rather than to a")
  open_("service acting for them -- EN 18219:2026 6.4.2 b) wants a Verifiable Credential")
  open_("at the operator DID for that, and none is attached today")
end
open_("that the trust anchor is an accredited one: EN 18246:2026 expects one,")
open_("and a self-managed DID log is not")
open_("anything about data the passport does not deliver publicly")

step(case verdict
     when EXIT_OK            then "VERDICT  content attested and unchanged"
     when EXIT_MISMATCH      then "VERDICT  MISMATCH -- do not rely on this passport"
     when EXIT_NO_COMMITMENT then "VERDICT  location bound, content not committed"
     else                         "VERDICT  incomplete -- see the open points above"
     end)
say(case signature
    when :valid   then signer == operator ? "         signed by its economic operator" : "         signed by #{signer}, not by its economic operator"
    when :invalid then "         its signature does NOT hold"
    else               "         not signed by its economic operator"
    end)
if changes[:versions].positive?
  say("         #{changes[:signed]} of #{changes[:versions]} recorded version(s) signed by its economic operator")
end
exit verdict
